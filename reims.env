# ==============================================================================
# REIMS — Arquivo Central de Configuração
# Edite aqui para trocar drivers, resolução, RAM, etc.
# Nenhum outro arquivo precisa ser alterado.
# ==============================================================================

# ── ORQUESTRAÇÃO (reims-ctl / QEMU) ───────────────────────────────────────────
VM_NAME="mac"                        # Nome da VM gerenciada pelo reims-ctl
USE_REIMS_CTL="true"                 # true = delega start/stop para reims-ctl | false = QEMU standalone
REIMS_CTL_VM_DIR="/root/.local/share/reims-ctl/vms/mac"
GPU_MODE="reims-vgpu"                # Opções: reims-vgpu (paravirtualizada) | vfio-nullmoth (passthrough RTX 3070)

# ── CPU ───────────────────────────────────────────────────────────────────────
CPU_CORES=6                          # Núcleos dedicados à VM (Ryzen 5 5600X)
CPU_THREADS=6                        # Threads totais apresentados ao macOS
CPU_MODEL="Skylake-Client-noTSX-IBRS" # Modelo de CPU validado no macOS Tahoe
CPU_VENDOR="GenuineIntel"            # Fabricante (nunca mude isso no macOS)
CPU_FLAGS="kvm=on,+invtsc,vmware-cpuid-freq=on,+ssse3,+sse4.2,+popcnt,+avx,+aes,+xsave,+xsaveopt,check"

# ── MEMÓRIA & ZERO-COPY DMA (udmabuf) ─────────────────────────────────────────
RAM="10G"                            # RAM dedicada à VM (máximo: 12G com 16G no host)
# ATENÇÃO: NUNCA defina UDMABUF_SIZE_LIMIT_MB >= 2048!
# No kernel Linux (drivers/dma-buf/udmabuf.c), valores >= 2048 causam integer
# overflow de 32 bits para 0, fazendo 100% dos ioctls UDMABUF_CREATE falharem com EINVAL (Errno 22).
UDMABUF_SIZE_LIMIT_MB=1024
UDMABUF_LIST_LIMIT=32768
VM_MAX_MAP_COUNT=4194304

# ── TELA — Modo Backend Fixo (Debian Invisível) ───────────────────────────────
# O macOS ocupa a tela inteira. O Debian é o backend silencioso.
DISPLAY_MODE="sdl"                   # sdl = janela | gtk = janela com menu | headless = sem janela (SSH only)
FULLSCREEN="on"                      # Liga tela cheia fixa ao iniciar
RESOLUCAO="1920x1080"                # Resolução fixa (nunca muda, como um Mac real)
GL_ACCEL="on"                        # Aceleração OpenGL na janela do host

# ── GPU / VRAM ────────────────────────────────────────────────────────────────
DRIVER_GPU="reims-graphics-pci"      # Driver paravirtualizado do Reims
VRAM_MB=4096                         # VRAM dedicada à VM (em MB)
# Para trocar de driver, substitua a linha acima por uma das opções:
#   DRIVER_GPU="virtio-vga-gl"       # Driver VirtIO padrão (fallback, sem Metal)
#   DRIVER_GPU="vmware-svga"         # Legado VMware (compatibilidade máxima)
#   DRIVER_GPU="reims-graphics-pci"  # Driver completo com Metal paravirtualizado

# ── VULKAN (Backend da RTX 3070) ──────────────────────────────────────────────
VK_ICD="/usr/share/vulkan/icd.d/nvidia_icd.json"
# Para trocar de GPU física do host, substitua pela ICD correta:
#   AMD    : /usr/share/vulkan/icd.d/radeon_icd.x86_64.json
#   Intel  : /usr/share/vulkan/icd.d/intel_icd.x86_64.json
#   NVIDIA : /usr/share/vulkan/icd.d/nvidia_icd.json  (seu caso atual)

# ── ÁUDIO PIPEWIRE ────────────────────────────────────────────────────────────
PIPEWIRE_UID=1000
PIPEWIRE_RUNTIME_DIR="/run/user/1000"
AUDIO_MODELO="ich9-intel-hda"        # Placa de som emulada (acompanha virtio-sound-pci)

# ── USB & INTEL AX200 (Wi-Fi VFIO + Bluetooth Passthrough) ────────────────────
USB_P2_PORTS=7                       # Portas USB 2.0 no qemu-xhci (p2+p3 = 14 <= limite 15 do macOS)
USB_P3_PORTS=7                       # Portas USB 3.0 no qemu-xhci
WIFI_VFIO_PCI="05:00.0"              # Endereço PCIe da Intel Wi-Fi 6 AX200
WIFI_PCI_ID="8086:2723"              # Vendor:Device ID da Intel Wi-Fi 6 AX200
BT_USB_VENDOR="0x8087"               # Vendor ID do Bluetooth Intel AX200
BT_USB_PRODUCT="0x0029"              # Product ID do Bluetooth Intel AX200

# ── DISCO ─────────────────────────────────────────────────────────────────────
DISCO_BASE="vms/tahoe_base.qcow2"
DISCO_LIVE="vms/tahoe_live.qcow2"
DISCO_TAMANHO="80G"

# ── REDE ──────────────────────────────────────────────────────────────────────
REDE_MODELO="virtio-net-pci"         # Adaptador de rede validado no macOS + QEMU
# Para expor a VM externamente via bridge de rede:
#   REDE_MODO="bridge"
#   REDE_BRIDGE="br0"               # Requer bridge pré-configurada no Debian
REDE_MODO="user"                     # user = NAT simples (sem configuração extra)
SSH_PORTA_HOST=2222                  # Porta SSH no host para acessar o macOS (./reims ssh)

# ── SSH REMOTO (Gerenciamento Externo) ────────────────────────────────────────
SSH_LISTEN_PORT=7777                 # Porta para gerenciar o host Debian remotamente
SSH_ALLOW_ROOT=false
SSH_AUTHORIZED_KEYS=""               # Cole sua chave pública aqui para acesso sem senha

# ── OVMF (Firmware UEFI) ──────────────────────────────────────────────────────
OVMF_CODE="efi/OVMF_CODE.fd"
OVMF_VARS="efi/OVMF_VARS.fd"
OPENCORE_IMG="efi/OpenCore_Tahoe.img"

# ── LOGS ──────────────────────────────────────────────────────────────────────
LOG_NIVEL="INFO"                     # INFO | DEBUG | QUIET
LOG_MAX_SESSOES=10                   # Máximo de arquivos de log mantidos
